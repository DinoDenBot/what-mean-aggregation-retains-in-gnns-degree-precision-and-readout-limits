{
  "schema_version": 1,
  "experiment_id": "inductive-csbm-transfer-v1",
  "protocol_status": "preregistered_not_run",
  "generator": {
    "kind": "balanced_two_class_contextual_sbm",
    "n": 4096,
    "feature_dimension": 8,
    "label_values": [-1, 1],
    "exact_balance": true,
    "undirected": true,
    "self_loops": false,
    "same_class_probability": "lambda*(1+rho)/(n-2)",
    "cross_class_probability": "lambda*(1-rho)/n",
    "feature_law": "X=mu*Y*e1+Normal(0,I_8)",
    "edge_sampler": "exact_bernoulli_geometric_skip"
  },
  "source_environment": {
    "condition": "source",
    "family": "source",
    "lambda": 24.0,
    "rho": 0.6,
    "mu": 0.35
  },
  "conditions": [
    {"condition": "source", "family": "source", "lambda": 24.0, "rho": 0.6, "mu": 0.35},
    {"condition": "lambda_low", "family": "degree", "lambda": 12.0, "rho": 0.6, "mu": 0.35},
    {"condition": "lambda_high", "family": "degree", "lambda": 48.0, "rho": 0.6, "mu": 0.35},
    {"condition": "rho_low", "family": "homophily", "lambda": 24.0, "rho": 0.3, "mu": 0.35},
    {"condition": "rho_high", "family": "homophily", "lambda": 24.0, "rho": 0.8, "mu": 0.35},
    {"condition": "mu_low", "family": "feature_signal", "lambda": 24.0, "rho": 0.6, "mu": 0.2},
    {"condition": "mu_high", "family": "feature_signal", "lambda": 24.0, "rho": 0.6, "mu": 0.5},
    {"condition": "combined_l12_r03_m02", "family": "combined", "lambda": 12.0, "rho": 0.3, "mu": 0.2},
    {"condition": "combined_l12_r03_m05", "family": "combined", "lambda": 12.0, "rho": 0.3, "mu": 0.5},
    {"condition": "combined_l12_r08_m02", "family": "combined", "lambda": 12.0, "rho": 0.8, "mu": 0.2},
    {"condition": "combined_l12_r08_m05", "family": "combined", "lambda": 12.0, "rho": 0.8, "mu": 0.5},
    {"condition": "combined_l48_r03_m02", "family": "combined", "lambda": 48.0, "rho": 0.3, "mu": 0.2},
    {"condition": "combined_l48_r03_m05", "family": "combined", "lambda": 48.0, "rho": 0.3, "mu": 0.5},
    {"condition": "combined_l48_r08_m02", "family": "combined", "lambda": 48.0, "rho": 0.8, "mu": 0.2},
    {"condition": "combined_l48_r08_m05", "family": "combined", "lambda": 48.0, "rho": 0.8, "mu": 0.5}
  ],
  "training_blocks": {
    "seeds": [17, 29, 43, 71, 101, 131, 173, 211],
    "source_train_graphs": 6,
    "source_validation_graphs": 2,
    "target_graphs_per_condition": 8,
    "common_graphs_across_architectures_within_block": true,
    "independent_namespaces": ["source_train", "source_validation", "target"]
  },
  "architectures": [
    {"name": "mean", "hidden_width": 64, "role": "confirmatory_normalized"},
    {"name": "mean_degree", "hidden_width": 64, "role": "confirmatory_degree_restoration"},
    {"name": "sum", "hidden_width": 64, "role": "context_cardinality_preserving"},
    {"name": "pna", "hidden_width": 24, "role": "context_degree_statistics"}
  ],
  "model": {
    "layers": 2,
    "activation": "silu",
    "dropout": 0.1,
    "classifier": "linear_to_one_logit",
    "degree_transform": "source_train_standardized_log1p_degree",
    "pna_statistics": ["mean", "standard_deviation", "maximum", "minimum"],
    "pna_scalers": ["identity", "log_amplification", "log_attenuation"],
    "pna_delta": "source_train_mean_log1p_degree"
  },
  "optimization": {
    "optimizer": "adamw",
    "learning_rate": 0.003,
    "weight_decay": 0.0001,
    "maximum_epochs": 300,
    "minimum_epochs": 50,
    "early_stopping_patience": 30,
    "early_stopping_minimum_improvement": 0.00001,
    "gradient_clip_norm": 5.0,
    "batching": "all_six_source_graphs_as_one_disjoint_full_batch",
    "loss": "binary_cross_entropy_with_logits",
    "target_tuning": false
  },
  "evaluation": {
    "weights_frozen": true,
    "primary_metric": "mean_node_log_loss_per_graph",
    "secondary_metrics": ["mean_node_accuracy_per_graph", "mean_node_brier_per_graph"],
    "degree_bins": [[0, 7], [8, 15], [16, 23], [24, 31], [32, 47], [48, null]],
    "minimum_nodes_per_graph_degree_bin": 50,
    "resampling_unit": "target_graph_nested_within_training_block"
  },
  "analysis": {
    "bootstrap_replicates": 10000,
    "bootstrap_seed": 20260905,
    "ordinary_interval_alpha": 0.05,
    "primary_conditions": ["lambda_low", "lambda_high"],
    "primary_one_sided_alpha_per_test": 0.0125,
    "secondary_log_loss_families": {
      "homophily": ["rho_low", "rho_high"],
      "feature_signal": ["mu_low", "mu_high"]
    },
    "secondary_two_sided_alpha_per_interval": 0.0125,
    "target_log_loss_advantage_margin": 0.001,
    "shift_gain_margin": 0.0005,
    "accuracy_equivalence_margin": 0.002,
    "little_log_loss_margin": 0.001,
    "primary_contrast": "mean_minus_mean_degree_log_loss",
    "shift_gain": "target_advantage_minus_source_advantage",
    "context_models_confirmatory": false
  },
  "validity": {
    "mean_degree_parameter_ratio_max": 1.02,
    "pna_parameter_ratio_lower": 0.8,
    "pna_parameter_ratio_upper": 1.2,
    "realized_mean_degree_relative_error_max": 0.1,
    "weights_hash_unchanged_required": true,
    "all_metrics_finite_required": true,
    "target_graph_pairing_required": true,
    "target_generation_after_global_freeze_required": true
  },
  "determinism": {
    "seed_derivation": "sha256_namespaced_31_bit",
    "numpy_seeded": true,
    "torch_seeded": true,
    "cudnn_benchmark": false,
    "tf32": false,
    "deterministic_algorithms": true,
    "numeric_reproduction": "same_pinned_image_and_gpu_with_recorded_tolerance"
  },
  "artifact_limit_bytes": 524288000
}
